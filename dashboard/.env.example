# =====================================================
# OTTO Dashboard env (internal use only)
# =====================================================
# These are read by Vite at build/dev time. Anything starting with VITE_
# is embedded in the bundle, so DO NOT put a service-role key here.
# Use the anon key with read-only RLS policies for any non-localhost
# deployment.  For localhost development the anon key is sufficient.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# When true, the dashboard serves canned mock data instead of querying
# Supabase.  Useful for offline previews; never enable in production.
VITE_MOCK_DASHBOARD=false
