# =====================================================
# OTTO Research Engine V1 - Environment Variables
# =====================================================
# Copy this file to .env and fill in real values.
# Do not commit your .env file.

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# --- eBay Browse API ---
# https://developer.ebay.com/
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
# Optional pre-fetched OAuth token (otherwise the client will obtain one)
EBAY_OAUTH_TOKEN=

# --- Keepa API (Amazon historical data) ---
KEEPA_API_KEY=

# --- Amazon Browser Automation (Playwright) ---
AMAZON_HEADLESS=true
AMAZON_SEARCH_TIMEOUT_MS=30000
AMAZON_MAX_RESULTS_PER_QUERY=10
AMAZON_MAX_QUERIES_PER_CANDIDATE=4
AMAZON_PROXY_SERVER=
AMAZON_PROXY_USERNAME=
AMAZON_PROXY_PASSWORD=
# When true, runs non-headless with slowMo and verbose logging.
AMAZON_DEBUG=false
# Dev/test only: ignore TLS errors (e.g. when a CI sandbox does TLS interception).
# Never enable in production - it disables certificate validation.
AMAZON_IGNORE_HTTPS_ERRORS=false
# Legacy: combined proxy URL kept for back-compat. Prefer AMAZON_PROXY_SERVER.
AMAZON_BROWSER_PROXY=

# --- Zik Analytics (browser automation placeholder) ---
ZIK_USERNAME=
ZIK_PASSWORD=

# --- Pipeline defaults ---
DEFAULT_ZIP_CODE=84107
DEFAULT_MAX_DELIVERY_DAYS=10
DEFAULT_MARKETPLACE_TARGET=EBAY_US

# --- Runtime flags ---
# When true, browser/API clients return deterministic mock data.
# Use only for local pipeline testing.
OTTO_MOCK_MODE=false
# When true, the eBay discovery agent always hits the live Browse API
# (requires EBAY_CLIENT_ID / EBAY_CLIENT_SECRET) regardless of OTTO_MOCK_MODE.
# Amazon / Keepa / Zik placeholder clients remain placeholders.
OTTO_REAL_EBAY_DISCOVERY=false
OTTO_LOG_LEVEL=info

# --- Export ---
OTTO_EXPORT_DIR=./exports
